# ==========================================================
# Akıllı Yüzme Okulu Yönetim Sistemi - Ortam Değişkenleri
# Smart Swimming School Management System - Environment
# ----------------------------------------------------------
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# Copy this file to `.env` and fill in the values.
#
# !!! `.env` DOSYASI ASLA GIT'E COMMIT EDİLMEZ !!!
# !!! NEVER COMMIT THE `.env` FILE !!!
#
# Bu dosyada GERÇEK bir anahtar, parola veya belirteç YOKTUR ve olmamalıdır.
# API anahtarları kurulumdan SONRA, arayüzdeki Ayarlar > Yapay Zekâ ekranından
# ya da yerel `.env` kopyanızdan girilir.
# This file contains NO real key, password or token, and never should.
# ==========================================================

# ---------- UYGULAMA / APPLICATION ----------
APP_NAME=Akıllı Yüzme Okulu Yönetim Sistemi
APP_ENV=development                 # development | production | test
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEFAULT_LANGUAGE=tr             # tr | en
APP_TIMEZONE=Europe/Istanbul
APP_CURRENCY=TRY

# ---------- GÜVENLİK / SECURITY ----------
# ÖNEMLİ: Üretimde mutlaka doldurun. Oluşturmak için:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Boş bırakılırsa her süreç başlangıcında rastgele bir anahtar üretilir;
# bu, sunucu her yeniden başladığında oturumları geçersiz kılar.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# İlk kurulum yöneticisi.
# Parola varsayılanı `admin`'dir ve bu bir SIR DEĞİLDİR: belgelenmiş, tek
# kullanımlık bir kurulum kapısıdır. Değiştirilene kadar
#   * hiçbir korumalı uca erişilemez,
#   * giriş yalnızca sunucunun çalıştığı cihazdan (127.0.0.1) kabul edilir.
# Değiştirildikten sonra `admin/admin` kalıcı olarak geçersizdir.
# Ayrıntı: backend/app/core/bootstrap.py ve SECURITY.md
FIRST_ADMIN_EMAIL=admin@yuzmeokulu.local
FIRST_ADMIN_PASSWORD=admin

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
# CORS - virgülle ayrılmış origin listesi
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- VERİTABANI / DATABASE ----------
# SQLite (varsayılan):
DATABASE_URL=sqlite:///./data/swimming_school.db
# PostgreSQL'e geçiş için örnek (kendi bilgilerinizle doldurun):
# DATABASE_URL=postgresql+psycopg://KULLANICI:PAROLA@localhost:5432/swimming_school
DATABASE_ECHO=false

# ---------- YEREL YAPAY ZEKA / LOCAL AI (LM Studio) ----------
# LM Studio > Developer > Start Server ile açılır. Varsayılan port 1234.
# Yerel model kullanıldığında hiçbir veri kurumdan çıkmaz.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://localhost:1234/v1
# LM Studio bir anahtar istemez; bu alan yalnızca protokol uyumu içindir.
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT=180
LOCAL_AI_MAX_TOKENS=2048
LOCAL_AI_TEMPERATURE=0.3

# ---------- NVIDIA BUILD API (BULUT / CLOUD) ----------
# Anahtarınızı https://build.nvidia.com adresinden alın ve BU DOSYAYA DEĞİL,
# kurulumdan sonra kendi yerel `.env` kopyanıza ya da bir sır yöneticisine
# yazın. Anahtar boşken sağlayıcı NOT_CONFIGURED durumunda kalır ve HİÇBİR
# çağrı yapmaz; yerel yapay zekâ ve AI dışı özellikler çalışmaya devam eder.
NVIDIA_ENABLED=false
NVIDIA_API_KEY=YOUR_PROVIDER_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TIMEOUT=120
NVIDIA_MAX_TOKENS=2048
NVIDIA_TEMPERATURE=0.3

# ---------- GENEL OPENAI-UYUMLU SAĞLAYICI / GENERIC PROVIDER ----------
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=YOUR_PROVIDER_API_KEY_HERE
OPENAI_COMPAT_MODEL=

# ---------- AI YÖNLENDİRME / AI ROUTING ----------
# Öncelik sırası: local | nvidia | openai_compat  (virgülle ayrılmış)
AI_FALLBACK_CHAIN=local,nvidia
AI_DEFAULT_MODE=automatic           # local | nvidia | automatic
AI_RESPONSE_LANGUAGE=auto           # tr | en | auto (arayüz dilini takip eder)
AI_LOG_PROMPTS=false                # Gizlilik: üretimde false bırakın

# ---------- AI DEVELOPER CONSOLE ----------
AI_DEVELOPER_ENABLED=true
AI_DEVELOPER_ALLOW_APPLY=false      # true ise yamalar onay sonrası uygulanabilir
AI_DEVELOPER_ALLOW_SHELL=false      # Kabuk komutlarına izin (varsayılan: kapalı)
AI_DEVELOPER_AUTO_TEST=true
AI_DEVELOPER_ROOT=.                 # Ajanın yazabileceği kök dizin (proje dışına çıkamaz)

# ---------- YEDEKLEME / BACKUP ----------
BACKUP_DIR=./backups
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_CRON=0 23 * * *     # Her gün 23:00
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ---------- LOGLAMA / LOGGING ----------
LOG_DIR=./logs
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false

# ---------- DEMO VERİSİ / SEED DATA ----------
# Sadece geliştirme ortamında true yapın. Üretimde seed çalışmayı reddeder.
# Üretilen bütün kayıtlar sentetiktir ve `is_demo=true` ile işaretlenir.
SEED_DEMO_DATA=true
